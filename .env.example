# Обязательно: API-ключ Checko.ru (https://checko.ru/user/account/api)
CHECKO_API_KEY=your_api_key_here

# Опционально: БИК действующего банка (9 цифр) для end-to-end smoke-теста (scripts/smoke.py).
# Если не задан — smoke.py пропустит реальный вызов API.
# Подставьте локально, не коммитьте значение в репозиторий.
# SMOKE_TEST_BIC=

# Опционально: число повторов при HTTP 429 и 5xx (по умолчанию 3).
# CHECKO_RETRIES=3

# Опционально: время жизни кэша ответов в секундах (по умолчанию 900, 0 отключает).
# Кэш нужен, чтобы повторный вопрос по тому же субъекту не оплачивался заново:
# каскадный отчёт тратит 5-6 запросов, а бесплатный тариф даёт 100 в сутки.
# CHECKO_CACHE_TTL=900
